/**
 * ${id} — Model Styles
 * Self-contained styling for the ${id} model demo page
 * Matches the visual language of the root index.html
 */

:root {
  --bg: #0a0f1a;
  --bg-elevated: #111827;
  --bg-card: #1a2234;
  --bg-input: #0f172a;
  --fg: #e8ecf4;
  --fg-muted: #8b95a6;
  --fg-subtle: #5a6578;
  --accent: ${color};
  --accent-dim: ${color_dim};
  --accent-glow: ${color_glow};
  --accent-strong: ${color_strong};
  --border: #2a3548;
  --border-light: #3a4558;
  --card-shadow: 0 4px 24px rgba(0, 0, 0, 0.4);
  --card-shadow-hover: 0 12px 48px ${color_glow};
  --radius: 16px;
  --radius-lg: 20px;
  --radius-sm: 8px;
  --radius-xl: 24px;
  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-fast: 0.15s ease-out;
  --font-ui: 'Space Grotesk', system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
  --focus-ring: 0 0 0 3px ${color_dim};
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html { scroll-behavior: smooth; }

body {
  font-family: var(--font-ui);
  background: var(--bg);
  color: var(--fg);
  min-height: 100vh;
  line-height: 1.6;
  font-size: 1rem;
  overflow-x: hidden;
}

/* Background */
.bg-grid {
  position: fixed; inset: 0; z-index: -1;
  background-image:
    linear-gradient(rgba(0, 212, 170, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 212, 170, 0.025) 1px, transparent 1px);
  background-size: 60px 60px;
  animation: gridMove 30s linear infinite;
}

@keyframes gridMove {
  0% { transform: translate(0, 0); }
  100% { transform: translate(60px, 60px); }
}

.bg-orbs {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
}

.orb {
  position: absolute; border-radius: 50%; filter: blur(100px); opacity: 0.35;
  animation: orbFloat 20s ease-in-out infinite;
}

.orb-1 { width: 500px; height: 500px; background: var(--accent); top: -150px; right: -150px; animation-delay: 0s; }
.orb-2 { width: 350px; height: 350px; background: #6366f1; bottom: -100px; left: -100px; animation-delay: -7s; }

@keyframes orbFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  25% { transform: translate(40px, -30px) scale(1.08); }
  50% { transform: translate(-30px, 40px) scale(0.92); }
  75% { transform: translate(20px, 35px) scale(1.05); }
}

/* Layout */
.container {
  max-width: 960px;
  margin: 0 auto;
  padding: 3rem 2rem 4rem;
  position: relative;
  z-index: 1;
}

/* Header */
.model-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 1px solid var(--border);
  flex-wrap: wrap;
}

.back-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--fg-muted);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  padding: 0.5rem 1rem;
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  background: var(--bg-card);
  transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
}

.back-link:hover {
  color: var(--accent);
  border-color: var(--accent-dim);
  background: var(--accent-dim);
}

.header-content {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.model-avatar {
  width: 64px;
  height: 64px;
  border-radius: 16px;
  background: linear-gradient(135deg, var(--accent), ${color_strong});
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-mono);
  font-weight: 700;
  font-size: 1.125rem;
  color: var(--bg);
  box-shadow: 0 8px 32px ${color_glow};
  flex-shrink: 0;
}

.header-content h1 {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0;
}

.badge {
  display: inline-flex;
  align-items: center;
  font-size: 0.625rem;
  font-weight: 700;
  padding: 0.25rem 0.75rem;
  border-radius: 9999px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.badge-system {
  background: var(--accent-dim);
  color: var(--accent);
  border: 1px solid var(--accent-glow);
}

.badge-custom {
  background: rgba(99, 102, 241, 0.2);
  color: #a5b4fc;
  border: 1px solid rgba(99, 102, 241, 0.3);
}

/* Panels */
.panel {
  background: linear-gradient(145deg, var(--bg-card), var(--bg-elevated));
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 2rem;
  margin-bottom: 2rem;
  position: relative;
  overflow: hidden;
}

.panel::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background: linear-gradient(90deg, var(--accent), #6366f1, #ec4899, var(--accent));
  background-size: 300% 100%;
  animation: panelShimmer 3s linear infinite;
}

@keyframes panelShimmer {
  0% { background-position: 300% 0; }
  100% { background-position: -300% 0; }
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}

.panel-header h2 {
  font-size: 1.25rem;
  font-weight: 700;
  margin: 0;
}

.panel-description {
  color: var(--fg-muted);
  font-size: 0.9375rem;
  margin-bottom: 1.5rem;
}

.endpoint-badge {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--accent);
  background: var(--accent-dim);
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--accent-glow);
}

/* Chat Demo */
.messages {
  min-height: 280px;
  max-height: 500px;
  overflow-y: auto;
  padding: 1.25rem;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  margin-bottom: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.message {
  padding: 1rem 1.25rem;
  border-radius: var(--radius);
  max-width: 85%;
  animation: messageIn 0.3s ease-out;
  line-height: 1.7;
  white-space: pre-wrap;
  word-wrap: break-word;
}

@keyframes messageIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}

.message.user {
  background: linear-gradient(135deg, var(--accent-dim), ${color_dim});
  border: 1px solid var(--accent-glow);
  margin-left: auto;
  border-bottom-right-radius: 4px;
}

.message.assistant {
  background: var(--bg-input);
  border: 1px solid var(--border);
  margin-right: auto;
  border-bottom-left-radius: 4px;
}

.message.loading {
  color: var(--fg-subtle);
  font-style: italic;
}

.message.error {
  background: rgba(239, 68, 68, 0.1);
  border-color: rgba(239, 68, 68, 0.3);
  color: #fca5a5;
}

.chat-form {
  display: flex;
  gap: 1rem;
  align-items: flex-end;
}

.input-group {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.input-group label {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--fg-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.chat-form input {
  width: 100%;
  padding: 1rem 1.25rem;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  color: var(--fg);
  font-family: var(--font-ui);
  font-size: 1rem;
  line-height: 1.5;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
}

.chat-form input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: var(--focus-ring);
  background: var(--bg-card);
}

.chat-form input::placeholder {
  color: var(--fg-subtle);
}

.input-hint {
  font-size: 0.75rem;
  color: var(--fg-subtle);
  font-family: var(--font-mono);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 1rem 1.5rem;
  font-family: var(--font-ui);
  font-size: 0.9375rem;
  font-weight: 600;
  border-radius: var(--radius);
  border: 1px solid transparent;
  cursor: pointer;
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-primary {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: var(--bg);
  border: none;
  box-shadow: 0 4px 16px ${color_glow};
}

.btn-primary:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px ${color_glow};
}

.btn-primary:active:not(:disabled) {
  transform: translateY(0);
}

.btn-test {
  background: var(--bg-input);
  color: var(--fg);
  border: 1px solid var(--border);
}

.btn-test:hover:not(:disabled) {
  background: var(--bg-card);
  border-color: var(--accent-dim);
  color: var(--accent);
}

/* API Reference Tabs */
.api-tabs {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
  border-bottom: 1px solid var(--border);
  padding-bottom: 0.5rem;
  flex-wrap: wrap;
}

.api-tab {
  padding: 0.75rem 1.25rem;
  background: transparent;
  border: 1px solid transparent;
  border-bottom: none;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  color: var(--fg-muted);
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
  position: relative;
  bottom: -1px;
}

.api-tab:hover {
  color: var(--fg);
  background: var(--bg-input);
}

.api-tab.active {
  color: var(--accent);
  background: var(--bg-card);
  border-color: var(--border);
  border-bottom-color: var(--bg-card);
}

.api-panel {
  display: none;
}

.api-panel.active {
  display: block;
  animation: fadeIn 0.2s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.api-panel pre {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.25rem;
  overflow-x: auto;
  margin-bottom: 1.5rem;
}

.api-panel code {
  font-family: var(--font-mono);
  font-size: 0.8125rem;
  line-height: 1.7;
  color: var(--fg);
}

.response-example {
  margin-bottom: 1.5rem;
}

.response-example h4 {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--fg-muted);
  margin-bottom: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.response-example pre {
  margin: 0;
}

.response-example code {
  white-space: pre-wrap;
  word-break: break-word;
}

/* Resilience Patterns */
.pattern-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.pattern-card {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  transition: border-color var(--transition), transform var(--transition), box-shadow var(--transition);
}

.pattern-card:hover {
  border-color: var(--accent-dim);
  transform: translateY(-4px);
  box-shadow: var(--card-shadow-hover);
}

.pattern-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-sm);
  background: var(--accent-dim);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  margin-bottom: 1rem;
}

.pattern-icon svg {
  width: 24px;
  height: 24px;
}

.pattern-card h3 {
  font-size: 1rem;
  font-weight: 700;
  margin-bottom: 0.5rem;
}

.pattern-card p {
  font-size: 0.875rem;
  color: var(--fg-muted);
  margin-bottom: 1rem;
  line-height: 1.6;
}

.pattern-card code {
  font-family: var(--font-mono);
  background: var(--bg);
  padding: 0.125rem 0.375rem;
  border-radius: 4px;
  color: var(--accent);
}

.test-results {
  min-height: 60px;
  padding: 1.25rem;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-family: var(--font-mono);
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--fg-muted);
  white-space: pre-wrap;
  transition: border-color var(--transition), background var(--transition);
}

.test-results.running {
  border-color: #f59e0b;
  background: rgba(245, 158, 11, 0.05);
  color: #fbbf24;
}

.test-results.success {
  border-color: var(--accent);
  background: var(--accent-dim);
  color: var(--accent);
}

.test-results.error {
  border-color: #ef4444;
  background: rgba(239, 68, 68, 0.1);
  color: #fca5a5;
}

/* Specification Compliance */
.compliance-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 1rem;
}

.compliance-item {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.compliance-item h4 {
  font-size: 0.9375rem;
  font-weight: 700;
}

.compliance-item p {
  font-size: 0.8125rem;
  color: var(--fg-muted);
  flex: 1;
}

.compliance-item code {
  font-family: var(--font-mono);
  color: var(--accent);
}

.compliance-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  padding: 0.375rem 1rem;
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.compliance-badge.pass {
  background: var(--accent-dim);
  color: var(--accent);
  border: 1px solid var(--accent-glow);
}

/* Footer */
footer {
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid var(--border);
  text-align: center;
  color: var(--fg-muted);
  font-size: 0.875rem;
}

footer a {
  color: var(--accent);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: border-color var(--transition-fast);
}

footer a:hover {
  border-color: var(--accent);
}

footer strong {
  color: var(--fg);
  font-family: var(--font-mono);
}

.generated-by {
  margin-top: 1rem;
  font-size: 0.75rem;
  color: var(--fg-subtle);
}

.generated-by strong {
  color: var(--accent);
}

/* Visually hidden */
.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* Scrollbar */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 4px; }
::-webkit-scrollbar-thumb:hover { background: var(--fg-subtle); }

/* Responsive */
@media (max-width: 768px) {
  .container { padding: 2rem 1rem 3rem; }
  .model-header { flex-direction: column; align-items: flex-start; }
  .header-content { width: 100%; }
  .chat-form { flex-direction: column; align-items: stretch; }
  .btn { width: 100%; }
  .panel { padding: 1.5rem; }
  .pattern-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .model-avatar { width: 56px; height: 56px; font-size: 1rem; }
  .header-content h1 { font-size: 1.5rem; }
  .panel-header { flex-direction: column; align-items: flex-start; }
  .api-tabs { overflow-x: auto; flex-wrap: nowrap; padding-bottom: 0.5rem; }
  .api-tab { white-space: nowrap; }
}

/* Print */
@media print {
  .bg-grid, .bg-orbs, .back-link, .chat-form, .btn-test, .test-results { display: none !important; }
  body { background: white; color: black; }
  .panel { break-inside: avoid; border: 1px solid #ddd; box-shadow: none; }
  .panel::before { display: none; }
}